# Model under evaluation
MODEL_BASE_URL=http://localhost:8899
MODEL_NAME=

# Summarizer service
SUMMARIZER_BASE_URL=http://localhost:8123
SUMMARIZER_MODEL=qwen3-32b

# Judge service
JUDGE_BASE_URL=http://localhost:8181/v1
USE_OPENAI_JUDGE=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Web search
USE_GOOGLE=true
SERPER_API_KEY=
# SERPER_API_KEYS=key1,key2,key3

# Optional hosted summarizer
DEEPSEEK_SUMMARIZER_BASE_URL=
DEEPSEEK_SUMMARIZER_API_KEYS=
DEEPSEEK_API_KEY=

# Optional internal search adapter, used only when USE_GOOGLE=false
MT_SEARCH_BASE_URL=
MT_SEARCH_AUTHORIZATION=
MT_SEARCH_USER_NAME=ai-search
MT_SEARCH_SOURCE=serper-search

# Runtime controls
DATASETS_CONFIG=
DATA_ROOT=.
EXP_NAME=vistahop_eval
MAX_CONCURRENT=64
MAX_TURNS=20
SERPER_CONCURRENCY=16
QUERY_CACHE_DIR=./cache/query_cache
TEMPERATURE=0.7
no_fetch=false
no_summary=false
